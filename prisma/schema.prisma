generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ASSISTANT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum PaymentStatus {
  PAID
  UNPAID
  PARTIAL
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
  COMPLETED
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  role      Role     @default(ASSISTANT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities ActivityLog[]
  editedAttendances AttendanceAuditLog[]
  recordedTransactions PaymentTransaction[]
  generatedSnapshots MonthlyGenerationSnapshot[]
  reservationScans ReservationScanLog[]
}

model Student {
  id           String   @id @default(cuid())
  studentId    String   @unique
  name         String
  teacherName  String?
  centerName   String?
  grade        String?
  monthlyFee   Float?
  notes        String?
  studentPhone String   @unique
  parentPhone  String?
  status       String?
  studentType  String
  importMonth  String?
  createdDate  String?
  receiver     String?
  isArchived   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Student Portal Auth
  passwordHash       String?
  mustChangePassword Boolean  @default(true)
  lastLogin          DateTime?

  sessionId    String?
  session      Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  attendances Attendance[]
  payments    Payment[]
  reservations Reservation[]
  waitingList  WaitingList[]

  @@index([studentId])
  @@index([sessionId])
}

model Session {
  id          String   @id @default(cuid())
  dayOfWeek   Int      // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  time        String   // e.g., "16:00"
  grade       String
  subject     String?
  teacherName String?
  capacity    Int?     @default(30)
  reservedSeats Int?   @default(0)
  confirmedSeats Int?  @default(0)
  price       Float?   @default(0)
  duration    String?  @default("60 min")
  room        String?  @default("Room 1")
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  students    Student[]
  attendances Attendance[]
  reservations Reservation[]
  waitingList  WaitingList[]

  @@index([grade])
}

model Reservation {
  id                String            @id @default(cuid())
  reservationNumber String            @unique
  studentId         String
  sessionId         String
  status            ReservationStatus @default(PENDING)
  reservedAt        DateTime          @default(now())
  expiresAt         DateTime
  confirmedAt       DateTime?
  confirmedBy       String?
  cancelledAt       DateTime?
  cancelledBy       String?
  completedAt       DateTime?
  notes             String?
  qrToken           String?           @unique
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  history   ReservationStatusHistory[]
  scans     ReservationScanLog[]

  @@index([studentId])
  @@index([sessionId])
  @@index([status])
  @@index([expiresAt])
}

model ReservationStatusHistory {
  id            String   @id @default(cuid())
  reservationId String
  oldStatus     String?
  newStatus     String
  changedById   String?
  changedByRole String?
  reason        String?
  createdAt     DateTime @default(now())

  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
}

model ReservationScanLog {
  id            String   @id @default(cuid())
  reservationId String
  scannerUserId String?
  scanTime      DateTime @default(now())
  action        String
  device        String?
  ip            String?
  scanResult    String?  // VALID, INVALID_SIGNATURE, NOT_FOUND, EXPIRED, CANCELLED, ALREADY_CONFIRMED, COMPLETED

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  scannerUser User?        @relation(fields: [scannerUserId], references: [id], onDelete: SetNull)

  @@index([reservationId])
}

model SeatLock {
  id        String   @id @default(cuid())
  sessionId String
  studentId String
  lockedAt  DateTime @default(now())
  expiresAt DateTime

  @@unique([sessionId, studentId])
  @@index([sessionId])
  @@index([expiresAt])
}

model WaitingList {
  id        String   @id @default(cuid())
  studentId String
  sessionId String
  status    String   @default("WAITING") // WAITING, PROMOTED, CANCELLED
  priority  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([studentId, sessionId])
  @@index([studentId])
  @@index([sessionId])
  @@index([status])
}

model Attendance {
  id        String           @id @default(cuid())
  studentId String
  sessionId String
  date      DateTime
  status    AttendanceStatus
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  isArchived Boolean         @default(false)

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  auditLogs AttendanceAuditLog[]

  @@unique([studentId, sessionId, date])
  @@index([studentId])
  @@index([sessionId])
  @@index([date])
}

model Payment {
  id        String        @id @default(cuid())
  studentId String
  amount     Float
  amountPaid Float?        @default(0)
  month      Int
  year       Int
  status     PaymentStatus @default(UNPAID)
  notes     String?
  paidAt    DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  transactions PaymentTransaction[]

  @@unique([studentId, month, year])
  @@index([studentId])
  @@index([month, year])
  @@index([status])
}

model PaymentTransaction {
  id            String   @id @default(cuid())
  paymentId     String
  amount        Float
  date          DateTime @default(now())
  paymentMethod String?  // e.g., Cash, Vodafone Cash, Instapay
  receiptNumber String?
  notes         String?
  recordedById  String?
  recordedBy    User?    @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  payment       Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  updatedAt   DateTime @updatedAt
}

model ActivityLog {
  id          String   @id @default(cuid())
  action      String
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  role        String?
  target      String?
  description String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model AttendanceAuditLog {
  id           String      @id @default(cuid())
  attendanceId String?
  attendance   Attendance? @relation(fields: [attendanceId], references: [id], onDelete: SetNull)
  oldStatus    String?
  newStatus    String
  editedById   String?
  editedBy     User?       @relation(fields: [editedById], references: [id], onDelete: SetNull)
  reason       String?
  createdAt    DateTime    @default(now())
}

model MonthlyGenerationSnapshot {
  id             String    @id @default(cuid())
  month          Int
  year           Int
  status         String    // "RUNNING", "COMPLETED", "FAILED"
  generatedById  String?
  generatedBy    User?     @relation(fields: [generatedById], references: [id], onDelete: SetNull)
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  executionTime  Int?      // in ms
  studentCount   Int       @default(0)
  createdCount   Int       @default(0)
  skippedCount   Int       @default(0)
  failedCount    Int       @default(0)
  archivedCount  Int       @default(0)
  inactiveCount  Int       @default(0)
  frozenCount    Int       @default(0)
  expectedRevenue Float    @default(0)
  failedStudents String?   @db.Text // JSON string of failed student IDs
  skippedDetails String?   @db.Text // JSON string of skipped students details
  
  @@unique([month, year])
  @@index([month, year])
}
