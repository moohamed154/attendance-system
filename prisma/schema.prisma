generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ASSISTANT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum PaymentStatus {
  PAID
  UNPAID
  PARTIAL
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  role      Role     @default(ASSISTANT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities ActivityLog[]
  editedAttendances AttendanceAuditLog[]
  recordedTransactions PaymentTransaction[]
  generatedSnapshots MonthlyGenerationSnapshot[]
}

model Student {
  id           String   @id @default(cuid())
  studentId    String   @unique
  name         String
  teacherName  String?
  centerName   String?
  grade        String?
  monthlyFee   Float?
  notes        String?
  studentPhone String?
  parentPhone  String?
  status       String?
  studentType  String?
  importMonth  String?
  createdDate  String?
  receiver     String?
  isArchived   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Student Portal Auth
  passwordHash       String?
  mustChangePassword Boolean  @default(true)
  lastLogin          DateTime?

  sessionId    String?
  session      Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  attendances Attendance[]
  payments    Payment[]

  @@index([studentId])
  @@index([sessionId])
}

model Session {
  id          String   @id @default(cuid())
  dayOfWeek   Int      // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  time        String   // e.g., "16:00"
  grade       String
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  students    Student[]
  attendances Attendance[]

  @@index([grade])
}

model Attendance {
  id        String           @id @default(cuid())
  studentId String
  sessionId String
  date      DateTime
  status    AttendanceStatus
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  isArchived Boolean         @default(false)

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  auditLogs AttendanceAuditLog[]

  @@unique([studentId, sessionId, date])
  @@index([studentId])
  @@index([sessionId])
  @@index([date])
}

model Payment {
  id        String        @id @default(cuid())
  studentId String
  amount     Float
  amountPaid Float?        @default(0)
  month      Int
  year       Int
  status     PaymentStatus @default(UNPAID)
  notes     String?
  paidAt    DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  transactions PaymentTransaction[]

  @@unique([studentId, month, year])
  @@index([studentId])
  @@index([month, year])
  @@index([status])
}

model PaymentTransaction {
  id            String   @id @default(cuid())
  paymentId     String
  amount        Float
  date          DateTime @default(now())
  paymentMethod String?  // e.g., Cash, Vodafone Cash, Instapay
  receiptNumber String?
  notes         String?
  recordedById  String?
  recordedBy    User?    @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  payment       Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  updatedAt   DateTime @updatedAt
}

model ActivityLog {
  id          String   @id @default(cuid())
  action      String
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  role        String?
  target      String?
  description String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model AttendanceAuditLog {
  id           String      @id @default(cuid())
  attendanceId String?
  attendance   Attendance? @relation(fields: [attendanceId], references: [id], onDelete: SetNull)
  oldStatus    String?
  newStatus    String
  editedById   String?
  editedBy     User?       @relation(fields: [editedById], references: [id], onDelete: SetNull)
  reason       String?
  createdAt    DateTime    @default(now())
}

model MonthlyGenerationSnapshot {
  id             String    @id @default(cuid())
  month          Int
  year           Int
  status         String    // "RUNNING", "COMPLETED", "FAILED"
  generatedById  String?
  generatedBy    User?     @relation(fields: [generatedById], references: [id], onDelete: SetNull)
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  executionTime  Int?      // in ms
  studentCount   Int       @default(0)
  createdCount   Int       @default(0)
  skippedCount   Int       @default(0)
  failedCount    Int       @default(0)
  archivedCount  Int       @default(0)
  inactiveCount  Int       @default(0)
  frozenCount    Int       @default(0)
  expectedRevenue Float    @default(0)
  failedStudents String?   @db.Text // JSON string of failed student IDs
  skippedDetails String?   @db.Text // JSON string of skipped students details
  
  @@unique([month, year])
  @@index([month, year])
}
