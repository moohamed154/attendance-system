# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local database files (SQLite dev artifacts - not used in production)
*.db
*.db-journal
*.db-wal
*.db-shm

# next-pwa generated files (regenerated at build time with per-deployment chunk hashes)
# CRITICAL: Never commit these — they contain hardcoded chunk filenames from the build
# that generated them. Serving stale SW files causes mobile browsers to fail silently.
public/sw.js
public/workbox-*.js

# dev artifacts
lint-report.txt
scratch/
test-*.mjs
amiri.zip
amiri_ext/

# playwright & test outputs
/playwright-report/
/test-results/
/.auth/
failed_tests_summary.json
check.ts
generate_audit.js
generate_markdown.js
parse_failures.js
